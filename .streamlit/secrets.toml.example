# 이 파일을 secrets.toml로 복사해 값을 채우세요. (secrets.toml은 GitHub에 올리지 마세요)
# Streamlit Community Cloud에서는 앱 설정 > Secrets 칸에 같은 내용을 붙여 넣어요.

# AI 피드백용 Anthropic API 키 (없으면 AI 버튼이 숨겨져요)
ANTHROPIC_API_KEY = "sk-ant-..."
# CLAUDE_MODEL = "claude-opus-5-5"

# 데이터 저장 위치. 비워 두면 앱 폴더의 SQLite 파일(feedback.db)에 저장돼요.
# Streamlit Cloud는 앱이 다시 시작되면 파일이 지워지므로, 수업에 쓸 때는
# Supabase·Neon 같은 무료 PostgreSQL 주소를 꼭 넣어 주세요.
# DB_URL = "postgresql://사용자:비밀번호@호스트:5432/데이터베이스"
